APP_NAME="Upgraded Broker"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Generate a unique, high-entropy key for every environment. Never reuse this example value.
APP_KEY=
APP_TIMEZONE=UTC
SESSION_NAME=upgradedbroker_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upgradedbroker
DB_USERNAME=upgradedbroker
DB_PASSWORD=
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Upgraded Broker"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Administrator
UPLOAD_MAX_BYTES=5242880
RATE_LIMIT_PER_MINUTE=60
MAINTENANCE_MODE=false
CACHE_ENABLED=true
TRUSTED_PROXIES=
GEOIP_DRIVER=auto
GEOIP_DATABASE_PATH=
GEOIP_REMOTE_FALLBACK=true
GEOIP_REMOTE_TIMEOUT=2
GEOIP_CACHE_SECONDS=21600
TRUST_CLOUDFLARE_COUNTRY_HEADER=false
